# ---- Required --------------------------------------------------------------
# OpenAI API key used for structured contract extraction. Never commit a real key.
OPENAI_API_KEY=
# MongoDB connection string (local MongoDB, Docker, or Atlas).
MONGODB_URI=mongodb+srv://user_name:password@cluster0.qdq1mbx.mongodb.net/
PORT=5000

# ---- Optional --------------------------------------------------------------
# Model used for extraction. Must support structured outputs (json_schema).
OPENAI_MODEL=gpt-4o-2024-08-06
# "openai" (default when OPENAI_API_KEY is set) or "demo": an offline, rule-based
# extractor so you can click through the UI without an API key. Demo only.
AI_PROVIDER=
# Browser origin allowed by CORS (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173
# Upload / parsing limits
MAX_UPLOAD_MB=10
MAX_DOCUMENT_CHARS=150000
# Date-status settings (days). Statuses are computed by application code.
DUE_SOON_DAYS=30
UPCOMING_WINDOW_DAYS=90
OBLIGATION_REMINDER_LEAD_DAYS=7
NOTICE_REMINDER_LEAD_DAYS=14
